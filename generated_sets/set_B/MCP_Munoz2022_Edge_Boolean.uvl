features
    EdgeSystem
        mandatory // Here the MCP-assisted model uses mandatory; the hand-written model has an or-group among Interface, VNF and Antenna
            Interface
                or
                    Mobile
                        alternative
                            "3G" {Cost 30}
                            "4G" {Cost 40}
                            "5G" {Cost 75}
                    WiFi
                    Ethernet {Cost 15}
            VNF
                or
                    Monitor
                    Firewall
                    Encryption
        optional
            Antenna
                alternative
                    Small {Cost 3}
                    Normal {Cost 4}
                    Large {Cost 5}

constraints
    Ethernet => !Antenna

// time -> 20 secs